node_modules/
.output/
out/
.wxt/
*.log
.DS_Store

# 临时脚本 / 一次性产物
tmp/

# WXT dev 用的固定 Chrome profile（保留「Allow User Scripts」等设置，避免每次重开）
.chrome-dev-profile/

# AI 协作工作数据（本机工作日志：含本机路径、会话过程与临时状态，不入库）
.workbuddy/

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea

# 测试产物
test-results
playwright-report
blob-report
coverage/

# AI SDK DevTools 本地调试数据（明文交互内容，不入库）
.devtools/

# 子包的构建产物（内置件 IIFE / Vite lib / preserveModules / esbuild 单文件——形态各异，
# dist 一律不入库防 drift，由 pnpm -r build 重建）
packages/*/dist/

# 中继件 IIFE 的生成物（user-scripts 的 build.mjs 从 relay 源码生成，build / test 前置重建，不入库防 drift）
packages/user-scripts/src/builtin/relay/relay-code.gen.ts
