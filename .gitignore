node_modules/
.output/
out/
.wxt/
*.log
.DS_Store

# 临时脚本 / 一次性产物
tmp/

# WXT dev 用的固定 Chrome profile（保留「Allow User Scripts」等设置，避免每次重开）
.chrome-dev-profile/

# AI 协作工作数据（本机工作日志：含本机路径、会话过程与临时状态，不入库）
.workbuddy/

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea

# 测试产物
test-results
playwright-report
blob-report
coverage/

# AI SDK DevTools 本地调试数据（明文交互内容，不入库）
.devtools/

# 内置件包的构建产物（件源码打成 IIFE，由 wxt.config.ts 的 publicAssets 钩子取进扩展产物）
packages/builtin-scripts/dist/

# 契约包的构建产物（Vite lib 模式：mjs / cjs / d.ts，消费方走 package.json exports）
packages/shared/dist/
