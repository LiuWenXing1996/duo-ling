{
  // 不 extends ./.wxt/tsconfig.json：那份是 `wxt prepare` 的产物，而 prepare 要先能 import 入口
  // （@duoling/* 走 exports → dist），必须晚于 `pnpm -r build`；反过来，构建期的 esbuild 与 oxc
  // 会从包目录向上读到根 tsconfig —— 「构建要它、它要构建」成环，干净 checkout 上必挂。
  // 下面 compilerOptions 抄自 WXT 0.21 的模板，升级 WXT 后对照 .wxt/tsconfig.json 核一遍。
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "paths": {
      "@": ["./src"],
      "@/*": ["./src/*"],
      // 内置件包：直指源码。构建（Vite / WXT 的 tsconfigPaths）与类型检查（vue-tsc）都走这条，
      // 于是包没被装上也不会在解析上翻车 —— 装不装只影响 node_modules 里的符号链接。
      "@duoling/user-scripts/builtin": ["./packages/user-scripts/src/builtin/index.ts"]
      // shared / service-worker / offscreen-document 与页面包源码直出（exports 指 src）。
      // user-scripts 的 builtin 产物是「扩展内路径的文件」而非被 import 的模块，故 paths 直指源码。
    },
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true
  },
  // e2e 一并纳入类型检查：Playwright 走 esbuild **只转译、不检查类型**，spec 里写错类型
  // 不会被任何门禁拦住（2026-09-22 就是靠真跑才发现白等了一次 120s 超时）。
  // 与 src 共用同一套 compilerOptions / 全局类型（e2e 导依赖用相对路径，不吃 `@/` 别名）。
  // packages 是内置件包的源码（TS），与 src 同为交付代码。各包另有包级 typecheck
  // （口径在 packages/tsconfig.base.json），根这道仍把它们一并查一遍。
  // user-scripts/samples 例外：样例有自己的宽松 tsconfig（strict:false + 自持 GM 类型面），
  // 不吃根的严格档；它对根的类型面只暴露 covers.ts（纯类型化数据，经 coverage 测试的
  // import 仍会被 vue-tsc 以根档检查）。
  "include": ["src/**/*", "e2e/**/*", "packages/**/*", "scripts/**/*", ".wxt/wxt.d.ts"],
  "exclude": [
    "node_modules",
    ".output",
    "tmp",
    "packages/user-scripts/src/samples",
    "packages/*/dist"
  ]
}
