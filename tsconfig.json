{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@": ["./src"],
      "@/*": ["./src/*"],
      // 内置件包：直指源码。构建（Vite / WXT 的 tsconfigPaths）与类型检查（vue-tsc）都走这条，
      // 于是包没被装上也不会在解析上翻车 —— 装不装只影响 node_modules 里的符号链接。
      "@duoling/builtin-scripts": ["./packages/builtin-scripts/src/index.ts"],
      "@duoling/builtin-scripts/install": ["./packages/builtin-scripts/src/install.ts"]
      // shared 与 userscript-runtime 已 Vite lib 化：走标准 exports → dist，不再 paths 直指源码。
      // builtin-scripts 的产物是「扩展内路径的文件」而非被 import 的模块，故仍 paths 直指源码。
    },
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true
  },
  // e2e 一并纳入类型检查：Playwright 走 esbuild **只转译、不检查类型**，spec 里写错类型
  // 不会被任何门禁拦住（2026-09-22 就是靠真跑才发现白等了一次 120s 超时）。
  // 与 src 共用同一套 compilerOptions / 全局类型（e2e 导依赖用相对路径，不吃 `@/` 别名）。
  // packages 是内置件包的源码（TS），与 src 同为交付代码，同一套门禁与全局类型。
  // uscript-samples 例外：样例有自己的宽松 tsconfig（strict:false + 自持 GM 类型面），
  // 不吃根的严格档；它对根的类型面只暴露 covers.ts（纯类型化数据，经 coverage 测试的
  // import 仍会被 vue-tsc 以根档检查）。
  "include": ["src/**/*", "e2e/**/*", "packages/**/*", ".wxt/wxt.d.ts"],
  "exclude": ["node_modules", ".output", "tmp", "packages/uscript-samples"]
}
