{
  "name": "duoling-plugin",
  "private": true,
  "version": "0.11.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=11.9.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "node scripts/dev.mts",
    "probe:serve": "node scripts/probe-target.mts",
    "model:serve": "node scripts/model-stub.mts",
    "build": "pnpm -r build && wxt build",
    "build:firefox": "pnpm -r build && wxt build --browser firefox",
    "typecheck": "pnpm -r build && pnpm -r typecheck && vue-tsc --noEmit",
    "test": "pnpm -r build && pnpm -r test && vitest run",
    "test:coverage": "pnpm -r build && vitest run --coverage",
    "test:e2e": "pnpm run build && playwright test",
    "verify:skills": "node scripts/verify-skills.mts",
    "check:todo": "node scripts/check-todo.mts",
    "check:comments": "node scripts/check-comments.mts",
    "check:comment-coverage": "node scripts/check-comment-coverage.mts",
    "pack:uscripts": "node scripts/pack-uscripts.mts",
    "release": "node scripts/release.mts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@ai-sdk/vue": "^4.0.99",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@duoling/builtin-scripts": "workspace:*",
    "@duoling/shared": "workspace:*",
    "@duoling/userscript-runtime": "workspace:*",
    "@isomorphic-git/lightning-fs": "4.7.0",
    "@lezer/highlight": "^1.2.3",
    "@lucide/vue": "^1.45.0",
    "@vueuse/core": "^14.4.0",
    "acorn": "^8.18.0",
    "ai": "^7.0.99",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "isomorphic-git": "1.42.2",
    "markdown-it": "^15.0.2",
    "motion-v": "^2.4.4",
    "nanoid": "^6.0.1",
    "process": "^0.11.10",
    "reka-ui": "^2.10.4",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "vue": "3.5.42",
    "vue-stick-to-bottom": "^1.0.1",
    "vue-stream-markdown": "^1.1.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@types/tampermonkey": "^5.5.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/test-utils": "^2.5.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "lefthook": "^2.2.2",
    "less": "^4.9.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "web-ext": "^10.6.0",
    "wxt": "0.21.4"
  }
}
