{
  // 包内编辑器与 vite-plugin-dts 的类型解析基准（根 tsconfig 另有一套全仓口径，两者并行）。
  // lib 带 DOM：api-contract 的类型签名引用 Blob / FormData / ArrayBufferView（GmXhrDetails
  // 刻意与 TM 的 details 对齐）；「零 DOM 假设」是运行时边界，这里只是类型层声明。语义与存储层零 chrome —— chrome 类型只服务防御式分支
  // （BroadcastChannel / chrome.runtime 降级路径）；运行时 chrome 由扩展环境提供，单测整体 stub。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["chrome"]
  },
  "include": ["src"]
}
