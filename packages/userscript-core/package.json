{
  "name": "@duoling/userscript-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GM 语义与存储内核：注入源码生成、API 契约与目录、grants 真相源、metadata 解析、脚本配置形状、内置存储与数据变更广播（Vite lib 模式构建）",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@duoling/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  }
}
