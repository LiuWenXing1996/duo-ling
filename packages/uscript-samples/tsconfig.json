{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "es2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // 样例的 GM 类型面自持（见 src/globals.d.ts）：@types/tampermonkey 的严格签名与真机 GM 面
    // 对不上（扩展有 GM.getValues / GM.addElement / GM.audio / GM_cookie 等非标成员），
    // 故不放行 @types 自动注入，避免两个类型面打架。
    "types": [],
    "allowJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.ts"]
}
