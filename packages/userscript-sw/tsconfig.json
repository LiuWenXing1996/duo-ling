{
  // 包内编辑器与 vite-plugin-dts 的类型解析基准（根 tsconfig 另有一套全仓口径，两者并行）。
  // 宿主层直接跑在 SW 里用 chrome.*（dl-bridge / dl-port / registration），chrome 类型常驻；
  // 运行时 chrome 由扩展环境提供（SW 全局），单测整体 stub（vi.stubGlobal）。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["chrome"]
  },
  "include": ["src"]
}
