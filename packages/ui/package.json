{
  "name": "@duoling/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./composables/*": "./src/composables/*.ts",
    "./components/*": "./src/components/*/index.ts"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@duoling/shadcn-registry": "workspace:*",
    "@duoling/shared": "workspace:*",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vue-tsc": "^3.3.11"
  },
  "description": "页面包 · 通用层：跨页业务 UI（ChatPanel 等）+ 前端数据客户端 + composables（shadcn 原语与 ai-elements 在 @duoling/shadcn-registry）"
}
