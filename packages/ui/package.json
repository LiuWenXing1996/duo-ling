{
  "name": "@duoling/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./composables/*": "./src/composables/*.ts",
    "./components/*": "./src/components/*/index.ts"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "convert-paths": "node scripts/convert-alias.mts"
  },
  "dependencies": {
    "@duoling/shared": "workspace:*",
    "@lucide/vue": "^1.45.0",
    "@vueuse/core": "^14.4.0",
    "ai": "^7.0.99",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion-v": "^2.4.4",
    "nanoid": "^6.0.1",
    "reka-ui": "^2.10.4",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "vue": "3.5.42",
    "vue-stick-to-bottom": "^1.0.1",
    "vue-stream-markdown": "^1.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vue-tsc": "^3.3.11"
  },
  "description": "页面包 · 通用层：跨页业务 UI（ChatPanel 等）+ 前端数据客户端 + composables + shadcn 原语与 ai-elements（vendored 组件，CLI add 后跑 convert-paths 转 @/ 为相对路径）"
}
