{
  // 包内编辑器与 vite-plugin-dts 的类型解析基准（根 tsconfig 另有一套全仓口径，两者并行）。
  // lib 带 DOM：api-contract 的类型签名引用 Blob / FormData / ArrayBufferView（GmXhrDetails
  // 刻意与 TM 的 details 对齐）；「零 DOM 假设」是运行时边界，由 boundary.test 把守，
  // 这里只是类型层声明。types 留空：不吃任何 @types（零 chrome.* / 零 node 类型）。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src"]
}
