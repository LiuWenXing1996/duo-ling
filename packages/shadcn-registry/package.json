{
  "name": "@duoling/shadcn-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components/ui/*": {
      "types": "./dist/components/ui/*/index.d.ts",
      "import": "./dist/components/ui/*/index.mjs"
    },
    "./components/ai-elements/*": {
      "types": "./dist/components/ai-elements/*/index.d.ts",
      "import": "./dist/components/ai-elements/*/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.45.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "ai": "^7.0.99",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion-v": "^2.4.4",
    "nanoid": "^6.0.1",
    "reka-ui": "^2.10.4",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vue": "3.5.42",
    "vue-stick-to-bottom": "^1.0.1",
    "vue-stream-markdown": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.2",
    "vue-tsc": "^3.3.11"
  }
}