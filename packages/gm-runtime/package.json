{
  "name": "@duoling/gm-runtime",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "以 Violentmonkey 的构建链产出可被扩展装配的 GM 运行时产物（内部包，不发布 registry）",
  "scripts": {
    "build": "node build/webpack.lib.cjs",
    "build:match": "node build/webpack.lib.cjs --entry=match",
    "build:injectors": "node build/webpack.lib.cjs --source=vm --entry=injected,injected-web",
    "build:runtime": "node build/webpack.lib.cjs --entry=sw && node build/webpack.lib.cjs --source=vm --entry=injected,injected-web && node build/webpack.lib.cjs --source=vm --entry=offscreen"
  },
  "dependencies": {
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@automattic/webpack-inline-constant-exports-plugin": "^1.0.0",
    "@babel/core": "^7.29.7",
    "@babel/helper-plugin-utils": "^7.29.7",
    "@babel/plugin-syntax-function-bind": "^7.29.7",
    "@babel/plugin-transform-for-of": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@vue/compiler-sfc": "^3.5.41",
    "babel-loader": "^10.1.1",
    "babel-plugin-transform-regex": "^6.1.0",
    "codemirror": "^5.65.21",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "deepmerge": "^4.3.1",
    "escape-string-regexp": "^5.0.0",
    "html-webpack-plugin": "^5.6.7",
    "js-yaml": "^4.1.0",
    "mini-css-extract-plugin": "^2.7.6",
    "progress-bar-webpack-plugin": "^2.1.0",
    "string-replace-loader": "^3.3.0",
    "terser-webpack-plugin": "^5.6.1",
    "unplugin-icons": "^23.0.1",
    "vue-loader": "^17.4.2",
    "webpack": "5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
