{
  // 样例的类型面自持（见 src/samples/globals.d.ts）：@types/tampermonkey 的严格签名与真机
  // GM 面对不上（扩展有 GM.getValues / GM.addElement / GM.audio / GM_cookie 等非标成员），
  // 故不放行 @types 自动注入，避免两个类型面打架；宽松档是刻意的（样例是给用户改着玩的）。
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "es2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "allowJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/samples/**/*.ts"]
}
